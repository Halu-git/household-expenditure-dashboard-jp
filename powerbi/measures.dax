// =====================================================================
// DAXメジャー集 — 日本の家計支出ダッシュボード
// 出典: 総務省統計局「家計調査(家計収支編)」(00200561)、二人以上の世帯
//
// 方針(設計書 §6.3):
//  - メジャーブランチング: 基礎メジャー(金額合計)を置き、派生は基礎を参照する。
//    ビジュアル側での列の直接集計(暗黙メジャー)は禁止。
//  - 分類ごとにメジャーを分ける(用途=_用途、品目=_品目)。分類をまたいで使わない。
//  - エンゲル係数は公表値をそのまま使う(再計算しない)。
//  - 系列断絶のある基礎的/選択的支出には、系列をまたぐ増減メジャーを
//    意図的に作らない(誤読防止を設計で担保)。
//  - 前年比・前年同月比は日付テーブルが不連続なため、年キー/月キーの算術で実装。
//  - 表示形式: 金額 #,##0"円" / 構成比・係数は小数1桁。
// =====================================================================

// ---------------------------------------------------------------------
// 基礎メジャー(用途分類: FactUseAnnual)
// ---------------------------------------------------------------------

支出金額_用途 =
SUM ( FactUseAnnual[Amount] )

消費支出_用途 =
CALCULATE (
    [支出金額_用途],
    DimItemUse[ItemName] = "消費支出"
)

// 大分類などの任意費目に対する構成比(同一分類内でのみ計算する)
構成比_用途 =
DIVIDE ( [支出金額_用途], [消費支出_用途] )

// 前年比(金額): 年キーの算術。公表の名目増減率がある項目ではそちらを優先表示すること
前年金額_用途 =
CALCULATE (
    [支出金額_用途],
    FILTER ( ALL ( DimYear ), DimYear[YearKey] = MAX ( DimYear[YearKey] ) - 1 )
)

前年比_用途 =
DIVIDE ( [支出金額_用途] - [前年金額_用途], [前年金額_用途] )

// エンゲル係数: 公表値(再掲行)をそのまま AVERAGE で拾う。再計算はしない
エンゲル係数 =
CALCULATE (
    AVERAGE ( FactUseAnnual[Amount] ),
    DimItemUse[ItemName] = "エンゲル係数(％)"
)

// ---------------------------------------------------------------------
// 基礎メジャー(品目分類: FactItemAnnual / FactItemMonthly)
// ---------------------------------------------------------------------

支出金額_品目_年次 =
SUM ( FactItemAnnual[Amount] )

支出金額_品目_月次 =
SUM ( FactItemMonthly[Amount] )

// 指数(2015年=100): 品目分類の年次。分類改定年をまたぐ中分類では注記必須
指数2015_品目 =
VAR Base =
    CALCULATE (
        [支出金額_品目_年次],
        FILTER ( ALL ( DimYear ), DimYear[YearKey] = 2015 )
    )
RETURN
    DIVIDE ( [支出金額_品目_年次], Base ) * 100

// 前年同月比(月次): 年月キー(YYYYMM)の算術で12か月前を引く
前年同月金額_品目 =
CALCULATE (
    [支出金額_品目_月次],
    FILTER (
        ALL ( DimDate ),
        DimDate[YearMonthKey] = MAX ( DimDate[YearMonthKey] ) - 100
    )
)

前年同月比_品目 =
DIVIDE ( [支出金額_品目_月次] - [前年同月金額_品目], [前年同月金額_品目] )

// ---------------------------------------------------------------------
// 地域(FactRegion)/ 年代(FactAge): ページ3・4専用。年はページフィルターで切替
// ---------------------------------------------------------------------

支出金額_地域 =
SUM ( FactRegion[Amount] )

消費支出_地域 =
CALCULATE (
    [支出金額_地域],
    FactRegion[ItemName] = "消費支出"
)

// 全国=100 のプロファイル用指数
全国比_地域 =
VAR National =
    CALCULATE (
        [支出金額_地域],
        FILTER ( ALL ( DimRegion ), DimRegion[Region] = "全国" )
    )
RETURN
    DIVIDE ( [支出金額_地域], National ) * 100

支出金額_年代 =
SUM ( FactAge[Amount] )

消費支出_年代 =
CALCULATE (
    [支出金額_年代],
    FactAge[ItemName] = "消費支出"
)

構成比_年代 =
DIVIDE ( [支出金額_年代], [消費支出_年代] )

// 年代ページの「平均」行は DimAge[IsAverage] で分離し、階級の棒グラフには含めない

// ---------------------------------------------------------------------
// 基礎的/選択的支出(FactBasicSelective)
// 注意: 改定年に2系列が重なる。描画時は必ず ClassificationSeries で
// 1系列に絞ること。系列をまたぐ前年比メジャーは作らない(意図的)。
// ---------------------------------------------------------------------

基礎的支出 =
SUM ( FactBasicSelective[BasicAmount] )

選択的支出 =
SUM ( FactBasicSelective[SelectiveAmount] )

基礎的支出比率 =
DIVIDE ( [基礎的支出], [基礎的支出] + [選択的支出] ) * 100

// ---------------------------------------------------------------------
// 世帯属性(DimAttributes): KPIカード用。全国・平均の行だけを参照する
// ---------------------------------------------------------------------

世帯人員 =
CALCULATE (
    AVERAGE ( DimAttributes[Value] ),
    DimAttributes[Dimension] = "地域",
    DimAttributes[GroupName] = "全国",
    DimAttributes[Attribute] = "世帯人員(人)"
)

世帯主の平均年齢 =
CALCULATE (
    AVERAGE ( DimAttributes[Value] ),
    DimAttributes[Dimension] = "地域",
    DimAttributes[GroupName] = "全国",
    DimAttributes[Attribute] = "世帯主の年齢(歳)"
)
